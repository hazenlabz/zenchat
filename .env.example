# ── Ollama (default local LLM) ────────────────────────────────────
VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_OLLAMA_DEFAULT_MODEL=llama3

# ── 9Router (local OpenAI-compatible, default: port 20128) ────────
# Untuk router/proxy lokal lain: LM Studio, llama.cpp, LocalAI, dll.
# Base URL mengikuti konvensi OpenAI (/v1/chat/completions, /v1/models)
VITE_9ROUTER_BASE_URL=http://localhost:20128/v1
VITE_9ROUTER_API_KEY=
VITE_9ROUTER_DEFAULT_MODEL=

# ── OpenRouter (https://openrouter.ai) ────────────────────────────
# Dapatkan API key di https://openrouter.ai/keys
# Bisa juga di-set runtime lewat Settings modal (tersimpan di localStorage)
VITE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_DEFAULT_MODEL=

# ── ComfyUI (image generation) ────────────────────────────────────
VITE_COMFY_BASE_URL=http://127.0.0.1:8188
VITE_COMFY_CHECKPOINT=v1-5-pruned-emaonly.ckpt

# ── Dev server port ───────────────────────────────────────────────
VITE_PORT=8989
